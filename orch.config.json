{
  "baseBranch": "main",
  "scheduler": {
    "maxParallel": 3,
    "maxAttempts": 2,
    "resumeOnRetry": true
  },
  "validation": {
    "command": "uv run ruff check . && uv run ruff format --check . && uv run pytest -m \"not perf\"",
    "agent": true
  },
  "git": {
    "pr": true,
    "mergePolicy": "auto",
    "squash": true,
    "copyFiles": [],
    "setupCommand": "uv sync --locked",
    "tickTasksMd": true
  }
}
